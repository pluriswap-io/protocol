pragma solidity ^0.8.28;

import {IDepositVerifier} from "../interfaces/IDepositVerifier.sol";

/// @title DepositVerifier
/// @notice The real `deposit` verifier behind the frozen `IDepositVerifier` (PROTOCOLO.md
///         §E.3.15.6, §E.3.15.9, V3): an ultra_honk proof generated by the pinned toolchain (see
///         circuits/README.md). The proof says "I know the `sk_id` and `salt` behind
///         `note = Poseidon(sk_id, token, amount, salt)`" — the one place a note is pinned to
///         the public amount, because this is the only place fresh value enters the notes world.
/// @dev Fail-closed everywhere: a malformed blob, an arg the proof's public inputs do not
///      name, a failed deploy, or any revert inside the generated verifier reads as `false` —
///      never as a revert-shaped pass (the interface pins this).
///
///      The proof blob is `proof || public_inputs` (bb's layout): the trailing 96 bytes are
///      the three public inputs in circuit order — `token`, `amount`, `note`. `token` is
///      compared as the numeric cast (`bytes32(uint256(uint160(token)))`): the proof's field
///      element is the address as an integer (right-aligned), never a left-aligned bytes20
///      cast. `amount` is raw: an amount at or over p can never equal the proof's field
///      element — fail-closed by construction. The Honk verifier itself is deployed from
///      committed initcode (`test/fixtures/verifiers/`, produced by `bun circuits:prove`) —
///      the main tree cannot compile it (via_ir vs the generated dispatchers; see
///      circuits/README.md) — and is called by address and selector, never linked.
contract DepositVerifier is IDepositVerifier {
    /// @dev `verify(bytes,bytes32[])` — the generated ultra_honk verifier's only entrypoint.
    bytes4 internal constant VERIFY_SELECTOR = bytes4(keccak256("verify(bytes,bytes32[])"));

    /// @dev (token, amount, note) — must mirror deposit's pub signature order.
    uint256 internal constant PUBLIC_INPUTS = 3;

    /// @dev The generated Honk verifier, deployed from initcode in the constructor. Zero
    ///      (deploy failed) fails every verify.
    address public immutable honkVerifier;

    constructor(bytes memory verifierInitcode) {
        address deployed;
        assembly {
            deployed := create(0, add(verifierInitcode, 0x20), mload(verifierInitcode))
        }
        honkVerifier = deployed;
    }

    /// @inheritdoc IDepositVerifier
    function verifyDeposit(address token, uint256 amount, bytes32 note, bytes calldata proof)
        external
        view
        returns (bool)
    {
        if (honkVerifier == address(0)) return false; // deploy failed — fail closed
        // A blob that cannot even carry the public inputs section is malformed: false,
        // never a panic (the empty-pubs path below would be an out-of-bounds read).
        if (proof.length < PUBLIC_INPUTS * 32) return false;
        (bytes32[] memory pubs, bytes calldata honkProof) = _split(proof);
        // The numeric cast, not a raw bytes20 cast: the proof's field element is the
        // address as an integer (right-aligned), while bytes32(bytes20) would left-align.
        if (pubs[0] != bytes32(uint256(uint160(token)))) return false; // raw address < p always
        if (pubs[1] != bytes32(amount)) return false; // raw amount; >= p can never match
        if (pubs[2] != note) return false; // the note the vault will insert
        return _verify(honkProof, pubs);
    }

    /// @dev Split the blob into the trailing public inputs and the proof body. Malformed
    ///      length returns empty pubs, which fails every caller's checks — never reverts.
    function _split(bytes calldata blob) internal pure returns (bytes32[] memory, bytes calldata) {
        if (blob.length < PUBLIC_INPUTS * 32) {
            return (new bytes32[](0), blob[0:0]);
        }
        uint256 proofLen = blob.length - PUBLIC_INPUTS * 32;
        bytes32[] memory pubs = new bytes32[](PUBLIC_INPUTS);
        for (uint256 i = 0; i < PUBLIC_INPUTS; i++) {
            pubs[i] = bytes32(blob[proofLen + i * 32:proofLen + (i + 1) * 32]);
        }
        return (pubs, blob[0:proofLen]);
    }

    /// @dev Call the generated verifier. `verify` is `view`: staticcall, so the adapter cannot
    ///      even be tricked into a state change; any revert or short/odd return is `false`.
    function _verify(bytes calldata honkProof, bytes32[] memory pubs) internal view returns (bool) {
        (bool ok, bytes memory ret) = honkVerifier.staticcall(abi.encodeWithSelector(VERIFY_SELECTOR, honkProof, pubs));
        return ok && ret.length == 32 && abi.decode(ret, (bool));
    }
}
