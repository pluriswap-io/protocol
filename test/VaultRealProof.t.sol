    /// What comes back is a public input (Anexo R, 2026-10-05): the whole lock's proof does not pass for a lock a
    /// court took its share of, and the cut one does not pass for the whole lock.
    function test_reabsorb_keptIsBound() public view {
        assertFalse(
            reabsorbVerifier.verifyReabsorb(
                dealId,
                dealSubject,
                token,
                lockAmount,
                lockAmount - 1,
                lockCommit,
                reabsorbNote,
                reabsorbNull,
                proofReabsorbBlob()
            ),
            "the whole lock's proof names the whole lock"
        );
        string memory cut = vm.readFile("test/fixtures/proofs/reabsorb_cut.json");
        bytes memory cutBlob = vm.parseJsonBytes(cut, ".proof_with_public_inputs");
        uint256 kept = vm.parseJsonUint(vectors, ".reabsorb.cut_kept");
        bytes32 cutNote = bytes32(vm.parseJsonUint(vectors, ".reabsorb.cut_new_note"));
        assertEq(kept, lockAmount - lockAmount * 1500 / 10_000, "the sample leaves 15% to the court");
        assertTrue(
            reabsorbVerifier.verifyReabsorb(
                dealId, dealSubject, token, lockAmount, kept, lockCommit, cutNote, reabsorbNull, cutBlob
            ),
            "a lock comes back without the court's share"
        );
        assertFalse(
            reabsorbVerifier.verifyReabsorb(
                dealId, dealSubject, token, lockAmount, lockAmount, lockCommit, cutNote, reabsorbNull, cutBlob
            ),
            "and never as the whole lock"
        );
        assertFalse(
            reabsorbVerifier.verifyReabsorb(
                dealId, dealSubject, token, lockAmount, kept, lockCommit, reabsorbNote, reabsorbNull, cutBlob
            ),
            "nor minting the whole lock's note"
        );
    }

    function test_withdraw_rejectsWrongArgs() public view {
        address wrongToken = address(uint160(uint256(keccak256("not-the-token"))));
        address wrongDest = address(uint160(uint256(keccak256("not-the-dest"))));
        uint256 wrongAmount = withdrawAmount + 1;
        bytes32 wrongChange = bytes32(uint256(keccak256("other-change")));
        bytes32 wrongNull = bytes32(uint256(keccak256("other-null")));
        bytes32 wrongRoot = bytes32(uint256(keccak256("other-root")));
        assertTrue(
            withdrawVerifier.verifyWithdraw(
                token, withdrawDest, withdrawAmount, withdrawChangeNote, withdrawNull, withdrawRoot, proofWithdrawBlob()
            )
        );
        assertFalse(
            withdrawVerifier.verifyWithdraw(
                wrongToken,
                withdrawDest,
                withdrawAmount,
                withdrawChangeNote,
                withdrawNull,
                withdrawRoot,
                proofWithdrawBlob()
            )
        );
        // The dest is bound IN the proof: another dest is another withdraw, unverifiable.
        assertFalse(
            withdrawVerifier.verifyWithdraw(
                token, wrongDest, withdrawAmount, withdrawChangeNote, withdrawNull, withdrawRoot, proofWithdrawBlob()
            )
        );
        assertFalse(
            withdrawVerifier.verifyWithdraw(
                token, withdrawDest, wrongAmount, withdrawChangeNote, withdrawNull, withdrawRoot, proofWithdrawBlob()
            )
        );
        assertFalse(
            withdrawVerifier.verifyWithdraw(
                token, withdrawDest, withdrawAmount, wrongChange, withdrawNull, withdrawRoot, proofWithdrawBlob()
            )
        );
        assertFalse(
            withdrawVerifier.verifyWithdraw(
                token, withdrawDest, withdrawAmount, withdrawChangeNote, wrongNull, withdrawRoot, proofWithdrawBlob()
            )
        );
        assertFalse(
            withdrawVerifier.verifyWithdraw(
                token, withdrawDest, withdrawAmount, withdrawChangeNote, withdrawNull, wrongRoot, proofWithdrawBlob()
            )
        );
    }

    function test_adapters_rejectTamperedProofs() public view {
        bytes memory blob = proofDepositBlob();
        blob[42] = blob[42] ^ 0xff;
        assertFalse(depositVerifier.verifyDeposit(token, depositAmount, depositNote, blob));

        blob = proofClaimBlob();
        blob[42] = blob[42] ^ 0xff;
        assertFalse(
            claimVerifier.verifyClaim(
                dealId,
                dealSubject,
                claimNewLeaf,
                nullRep1,
                IReputation.Close.Peaceful,
                token,
                100_000_000,
                claimRoot,
                pairTag(),
                claimEpoch(),
                true,
                blob
            )
        );

        blob = proofReabsorbBlob();
        blob[42] = blob[42] ^ 0xff;
        assertFalse(
            reabsorbVerifier.verifyReabsorb(
                dealId, dealSubject, token, lockAmount, lockAmount, lockCommit, reabsorbNote, reabsorbNull, blob
            )
        );

        blob = proofWithdrawBlob();
        blob[42] = blob[42] ^ 0xff;
        assertFalse(
            withdrawVerifier.verifyWithdraw(
                token, withdrawDest, withdrawAmount, withdrawChangeNote, withdrawNull, withdrawRoot, blob
            )
        );
    }

